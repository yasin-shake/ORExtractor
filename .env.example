# OpenAI — used for embeddings only
OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_BASE_URL=  # Optional: set to use a custom OpenAI-compatible endpoint
OPENAI_EMBED_MODEL=text-embedding-3-small

# AWS Bedrock — used for chat/generation and structured extraction
AWS_REGION=us-east-2



BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# API key for the REST API (optional — leave blank for open local access)
# API_KEY=

RAG_KNOWLEDGE_DIR=knowledge
# Additional read-only PDF directories (semicolon-separated). These are scanned during
# ingestion and extraction but uploads/deletes always go to RAG_KNOWLEDGE_DIR.
RAG_EXTRA_PDF_DIRS=C:\Users\Administrator\Desktop\vscode_projects\geo_extractor\PDFs
RAG_CHROMA_DIR=.chroma_db
RAG_COLLECTION_NAME=ni43101_knowledge
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=64
RAG_UPSERT_BATCH_SIZE=24
# RAG_PARSE_STRATEGY is ignored — parsing now uses PyMuPDF (fitz) directly
# RAG_PARSE_STRATEGY=fitz
RAG_TOP_K=8

# Structured extraction
RAG_EXTRACTED_DIR=extracted_data
NI43101_EXTRACT_TOP_K=12

# Agentic chapter-directed chat (1=enabled, 0=fallback to simple RAG)
AGENT_CHAT=1
# langgraph = ReAct tool-calling agent (default); pipeline = deterministic fallback
AGENT_MODE=langgraph
# Set to 1 to run tools without Bedrock (routing/retrieval/benchmark smoke test)
# AGENT_DRY_RUN=0
