# Embeddings — local Qwen primary, OpenAI startup fallback
EMBEDDING_PROVIDER=qwen
EMBEDDING_FALLBACK_PROVIDER=openai
LOCAL_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBED_DEVICE=cuda
LOCAL_EMBED_BATCH_SIZE=16
LOCAL_EMBED_MAX_LENGTH=512
LOCAL_EMBED_DIMENSIONS=1024
LOCAL_EMBED_DTYPE=float16
LOCAL_EMBED_QUERY_INSTRUCTION=Given a technical due diligence question about an NI 43-101 mining report, retrieve relevant report passages that answer the question

# Required only when OpenAI is primary or Qwen startup falls back to OpenAI
OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_BASE_URL=  # Optional: set to use a custom OpenAI-compatible endpoint
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# AWS Bedrock — used for chat/generation and structured extraction
AWS_REGION=us-east-2



BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# API key for the REST API (optional — leave blank for open local access)
# API_KEY=

RAG_KNOWLEDGE_DIR=knowledge
# Additional read-only PDF directories (semicolon-separated). These are scanned during
# ingestion and extraction but uploads/deletes always go to RAG_KNOWLEDGE_DIR.
RAG_EXTRA_PDF_DIRS=C:\Users\Administrator\Desktop\vscode_projects\geo_extractor\PDFs
RAG_CHROMA_DIR=.chroma_db
RAG_COLLECTION_NAME=ni43101_knowledge
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=64
RAG_UPSERT_BATCH_SIZE=128
# RAG_PARSE_STRATEGY is ignored — parsing now uses PyMuPDF (fitz) directly
# RAG_PARSE_STRATEGY=fitz
RAG_TOP_K=8

# Structured extraction
RAG_EXTRACTED_DIR=extracted_data
NI43101_EXTRACT_TOP_K=12

# Spatial/geological-model extraction (rag_app.py extract --spatial)
RAG_SPATIAL_DIR=spatial_data

# Bounded parse -> enrich -> embed pipeline
INGEST_PIPELINE_ENABLED=true
INGEST_PIPELINE_QUEUE_SIZE=2

# Agentic chapter-directed chat (1=enabled, 0=fallback to simple RAG)
AGENT_CHAT=1
# langgraph = ReAct tool-calling agent (default); pipeline = deterministic fallback
AGENT_MODE=langgraph
# Set to 1 to run tools without Bedrock (routing/retrieval/benchmark smoke test)
# AGENT_DRY_RUN=0

# ── Ingestion backend ─────────────────────────────────────────────────────────
# docling (primary) | mineru (forced fallback)
INGESTION_BACKEND=docling
PARSER_PRIMARY=docling
PARSER_FALLBACK=mineru
PARSER_FALLBACK_ENABLED=true

# Docling primary parser
DOCLING_EXECUTION_MODE=local
DOCLING_SERVE_URL=
DOCLING_SERVE_API_KEY=
DOCLING_DO_OCR=true
DOCLING_OCR_BACKEND=onnxruntime
DOCLING_OCR_LANGUAGES=english
DOCLING_FORCE_FULL_PAGE_OCR=false
DOCLING_OCR_BITMAP_AREA_THRESHOLD=0.05
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate
DOCLING_GENERATE_PAGE_IMAGES=true
DOCLING_GENERATE_PICTURE_IMAGES=true
# Conservative local-memory defaults. Increase only after measuring peak RAM.
DOCLING_IMAGES_SCALE=1.0
DOCLING_OCR_BATCH_SIZE=2
DOCLING_LAYOUT_BATCH_SIZE=2
DOCLING_TABLE_BATCH_SIZE=1
DOCLING_QUEUE_MAX_SIZE=2
DOCLING_PAGE_BATCH_SIZE=2
DOCLING_NUM_THREADS=4
DOCLING_DEVICE=auto
DOCLING_ADAPTIVE_OCR=true
DOCLING_NATIVE_TEXT_MIN_CHARS=80
DOCLING_NATIVE_TEXT_COVERAGE=0.98
DOCLING_NATIVE_TEXT_MAX_EMPTY_PAGES=2
DOCLING_BATCH_FALLBACK_ENABLED=true
DOCLING_SAFE_BATCH_SIZE=1
DOCLING_FAST_TABLE_MAX_PAGES=20
DOCLING_PROFILING=true
DOCLING_CONVERTER_CACHE_SIZE=2
DOCLING_HEADING_HIERARCHY=true
DOCLING_TIMEOUT_SECONDS=900
DOCLING_MAX_PAGES=1000
DOCLING_MAX_FILE_MB=2048
DOCLING_MODEL_ARTIFACT_REVISION=

# MinerU deterministic fallback (service recommended; CLI runs isolated)
MINERU_EXECUTION_MODE=service
MINERU_API_URL=
MINERU_API_TOKEN=
MINERU_COMMAND=mineru
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=1800

# Parser quality gates (calibrate on the NI 43-101 benchmark corpus)
PARSER_MIN_TEXT_PAGE_COVERAGE=0.90
PARSER_MAX_EMPTY_PAGE_RATIO=0.10
PARSER_MAX_REPLACEMENT_CHAR_RATIO=0.01
PARSER_MIN_TABLE_VALID_RATIO=0.80
PARSER_REQUIRE_PICTURE_CROPS=false

# Ingestion artifacts (figure crops, table HTML, enrichments, reconstructions)
RAG_ARTIFACT_DIR=ingestion_artifacts

# Bedrock visual enrichment (Claude Haiku — separate from chat/extract model)
BEDROCK_VISUAL_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_VISUAL_MAX_TOKENS=3500
BEDROCK_VISUAL_CONCURRENCY=8
BEDROCK_VISUAL_CONFIDENCE_THRESHOLD=0.85

# Visual processing gates
VISUAL_MIN_WIDTH=250
VISUAL_MIN_HEIGHT=150
VISUAL_MAX_WIDTH=4096
VISUAL_MAX_HEIGHT=4096
VISUAL_MAX_CALLS_PER_REPORT=30
VISUAL_MAX_TABLE_CALLS_PER_REPORT=20
VISUAL_MAX_FIGURE_CALLS_PER_REPORT=10
VISUAL_TOKEN_BUDGET_PER_REPORT=350000
VISUAL_RECONSTRUCT_CHARTS=1
VISUAL_RECONSTRUCT_DIAGRAMS=1
VISUAL_ENRICHMENT_ENABLED=1

# LangSmith (payload content tracing off by default)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orextractor-ingestion
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# LANGSMITH_API_KEY=

# API upload size limit (MB)
MAX_UPLOAD_MB=2048
