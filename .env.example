# OpenAI — used for embeddings only
OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_BASE_URL=  # Optional: set to use a custom OpenAI-compatible endpoint
OPENAI_EMBED_MODEL=text-embedding-3-small

# AWS Bedrock — used for chat/generation and structured extraction
AWS_REGION=us-east-2



BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# API key for the REST API (optional — leave blank for open local access)
# API_KEY=

RAG_KNOWLEDGE_DIR=knowledge
# Additional read-only PDF directories (semicolon-separated). These are scanned during
# ingestion and extraction but uploads/deletes always go to RAG_KNOWLEDGE_DIR.
RAG_EXTRA_PDF_DIRS=C:\Users\Administrator\Desktop\vscode_projects\geo_extractor\PDFs
RAG_CHROMA_DIR=.chroma_db
RAG_COLLECTION_NAME=ni43101_knowledge
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=64
RAG_UPSERT_BATCH_SIZE=24
# RAG_PARSE_STRATEGY is ignored — parsing now uses PyMuPDF (fitz) directly
# RAG_PARSE_STRATEGY=fitz
RAG_TOP_K=8

# Structured extraction
RAG_EXTRACTED_DIR=extracted_data
NI43101_EXTRACT_TOP_K=12

# Spatial/geological-model extraction (rag_app.py extract --spatial)
RAG_SPATIAL_DIR=spatial_data

# Agentic chapter-directed chat (1=enabled, 0=fallback to simple RAG)
AGENT_CHAT=1
# langgraph = ReAct tool-calling agent (default); pipeline = deterministic fallback
AGENT_MODE=langgraph
# Set to 1 to run tools without Bedrock (routing/retrieval/benchmark smoke test)
# AGENT_DRY_RUN=0

# ── Ingestion backend ─────────────────────────────────────────────────────────
# olmocr (default, temporary compatibility) | unstructured (new pipeline)
INGESTION_BACKEND=olmocr

# Unstructured (used when INGESTION_BACKEND=unstructured)
UNSTRUCTURED_PROVIDER=local
UNSTRUCTURED_STRATEGY=hi_res
UNSTRUCTURED_API_URL=
UNSTRUCTURED_API_KEY=

# Ingestion artifacts (figure crops, table HTML, enrichments, reconstructions)
RAG_ARTIFACT_DIR=ingestion_artifacts

# Bedrock visual enrichment (Claude Haiku — separate from chat/extract model)
BEDROCK_VISUAL_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_VISUAL_MAX_TOKENS=3500
BEDROCK_VISUAL_CONCURRENCY=6
BEDROCK_VISUAL_CONFIDENCE_THRESHOLD=0.85

# Visual processing gates
VISUAL_MIN_WIDTH=250
VISUAL_MIN_HEIGHT=150
VISUAL_RECONSTRUCT_CHARTS=1
VISUAL_RECONSTRUCT_DIAGRAMS=1
VISUAL_ENRICHMENT_ENABLED=1

# LangSmith (payload content tracing off by default)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=orextractor-ingestion
LANGSMITH_TRACE_CONTENT=false
# LANGSMITH_API_KEY=

# API upload size limit (MB)
MAX_UPLOAD_MB=2048

# ── olmocr PDF parsing (INGESTION_BACKEND=olmocr) ─────────────────────────────
# URL of an OpenAI-compatible inference server running olmOCR (local or remote).
# Leave unset to use the fast PyMuPDF text-layer fallback instead.
# Local GPU example:  OLMOCR_SERVER_URL=http://localhost:8000/v1
# Remote example:     OLMOCR_SERVER_URL=https://api.cirrascale.com/v1
OLMOCR_SERVER_URL=
OLMOCR_API_KEY=
OLMOCR_MODEL=allenai/olmOCR-7B-0225-preview
# Parallel page workers sent to the inference server per PDF (default: 4)
OLMOCR_WORKERS=4
