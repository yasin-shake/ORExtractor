# Embeddings
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_EMBED_MODEL=text-embedding-3-small

# Bedrock chat/extraction
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Protect the API before exposing it outside the machine
API_KEY=replace-with-a-long-random-secret

RAG_KNOWLEDGE_DIR=knowledge
RAG_EXTRA_PDF_DIRS=
RAG_CHROMA_DIR=.chroma_db
RAG_COLLECTION_NAME=ni43101_knowledge
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=64
RAG_UPSERT_BATCH_SIZE=24
RAG_TOP_K=8
RAG_EXTRACTED_DIR=extracted_data
NI43101_EXTRACT_TOP_K=12
RAG_SPATIAL_DIR=spatial_data

AGENT_CHAT=1
AGENT_MODE=langgraph

# Local vLLM server in the same WSL distro
OLMOCR_SERVER_URL=http://127.0.0.1:8001/v1
OLMOCR_API_KEY=olmocr-local
OLMOCR_MODEL=allenai/olmOCR-2-7B-1025-FP8

# A 5070 Ti has limited headroom at 16 GB. Start with one page request at a time.
OLMOCR_WORKERS=1

# Per uploaded PDF. Raise only if required.
MAX_UPLOAD_MB=2048
