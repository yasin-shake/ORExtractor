
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1440">
<title>Eskay Creek — AI Extraction Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9A84C;
    --gold-light: #E8C96B;
    --gold-dim: #7a6228;
    --bg: #0A0A0B;
    --surface: #111113;
    --surface2: #18181C;
    --border: rgba(201,168,76,0.18);
    --text: #E8E4D8;
    --muted: #7a7870;
    --green: #4CAF7B;
    --red: #E05252;
    --yellow: #E0B84C;
    --silver: #A8B4C0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    line-height: 1.5;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Background texture */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 20% 10%, rgba(201,168,76,0.04) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 80% 90%, rgba(168,180,192,0.03) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .page {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 48px;
  }

  /* HEADER */
  .header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
    animation: fadeDown 0.6s ease both;
  }

  .header-left { }

  .eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    letter-spacing: 0.04em;
    line-height: 0.95;
    color: var(--text);
  }

  .title span {
    color: var(--gold);
  }

  .subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--muted);
    margin-top: 8px;
  }

  .header-right {
    text-align: right;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(76,175,123,0.1);
    border: 1px solid rgba(76,175,123,0.3);
    color: var(--green);
    padding: 6px 14px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .status-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .meta {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  /* KPI STRIP */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 32px;
    animation: fadeUp 0.7s 0.1s ease both;
  }

  .kpi {
    background: var(--surface);
    padding: 20px 22px;
    position: relative;
    overflow: hidden;
    transition: background 0.2s;
  }

  .kpi:hover { background: var(--surface2); }

  .kpi::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.3s;
    transform-origin: left;
  }

  .kpi:hover::after { transform: scaleX(1); }

  .kpi-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .kpi-value {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    letter-spacing: 0.03em;
    color: var(--gold-light);
    line-height: 1;
    margin-bottom: 4px;
  }

  .kpi-sub {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  /* MAIN GRID */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 380px;
    gap: 20px;
    margin-bottom: 20px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 24px;
    animation: fadeUp 0.7s 0.2s ease both;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 500;
  }

  .panel-tag {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.1em;
    background: rgba(255,255,255,0.04);
    padding: 3px 8px;
    border: 1px solid rgba(255,255,255,0.07);
  }

  /* PRODUCTION CHART */
  .chart-area {
    height: 200px;
    position: relative;
    margin-bottom: 16px;
  }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 100%;
    padding-top: 20px;
  }

  .bar-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    justify-content: flex-end;
  }

  .bar-wrap {
    width: 100%;
    display: flex;
    gap: 2px;
    align-items: flex-end;
    flex: 1;
  }

  .bar {
    flex: 1;
    border-radius: 1px 1px 0 0;
    transition: opacity 0.2s;
    cursor: pointer;
    position: relative;
    animation: growUp 0.8s ease both;
  }

  .bar:hover { opacity: 0.8; }

  .bar-au {
    background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 100%);
  }

  .bar-ag {
    background: linear-gradient(180deg, #d0d8e0 0%, var(--silver) 100%);
    opacity: 0.5;
  }

  .bar-label {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .chart-legend {
    display: flex;
    gap: 20px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 1px;
  }

  /* RESOURCE TABLE */
  .res-table {
    width: 100%;
    border-collapse: collapse;
  }

  .res-table th {
    font-size: 8px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 8px 10px;
    text-align: right;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }

  .res-table th:first-child { text-align: left; }

  .res-table td {
    padding: 9px 10px;
    text-align: right;
    font-size: 11px;
    border-bottom: 1px solid rgba(201,168,76,0.06);
    color: var(--text);
    font-weight: 300;
  }

  .res-table td:first-child { text-align: left; }

  .res-table tr.total td {
    color: var(--gold-light);
    font-weight: 500;
    border-top: 1px solid var(--border);
    border-bottom: none;
    padding-top: 12px;
  }

  .cat-measured { color: var(--gold); }
  .cat-indicated { color: var(--silver); }
  .cat-inferred { color: var(--muted); }
  .cat-mi { color: var(--gold-light); font-weight: 500; }

  /* VALIDATION PANEL */
  .validation-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .val-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: rgba(255,255,255,0.02);
    border-left: 2px solid transparent;
  }

  .val-item.green { border-left-color: var(--green); }
  .val-item.red { border-left-color: var(--red); }
  .val-item.yellow { border-left-color: var(--yellow); }

  .val-icon {
    font-size: 12px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .val-title {
    font-size: 10px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.05em;
    margin-bottom: 3px;
  }

  .val-desc {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  /* BOTTOM GRID */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    animation: fadeUp 0.7s 0.3s ease both;
  }

  /* COST BREAKDOWN BARS */
  .cost-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .cost-label {
    font-size: 9px;
    color: var(--muted);
    width: 80px;
    flex-shrink: 0;
    letter-spacing: 0.06em;
  }

  .cost-bar-wrap {
    flex: 1;
    height: 16px;
    background: rgba(255,255,255,0.04);
    position: relative;
    overflow: hidden;
  }

  .cost-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold));
    animation: growRight 1s ease both;
  }

  .cost-val {
    font-size: 9px;
    color: var(--gold-light);
    width: 50px;
    text-align: right;
    flex-shrink: 0;
  }

  /* ROYALTY TABLE */
  .roy-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 0;
    border-bottom: 1px solid rgba(201,168,76,0.07);
    gap: 10px;
  }

  .roy-id {
    font-size: 9px;
    color: var(--gold-dim);
    width: 56px;
    flex-shrink: 0;
    letter-spacing: 0.1em;
  }

  .roy-name {
    font-size: 10px;
    color: var(--text);
    flex: 1;
    font-weight: 400;
  }

  .roy-rate {
    font-size: 11px;
    color: var(--gold-light);
    font-weight: 500;
    width: 42px;
    text-align: right;
  }

  .roy-lom {
    font-size: 10px;
    color: var(--muted);
    width: 56px;
    text-align: right;
  }

  /* TAX PANEL */
  .tax-donut {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 16px 0;
  }

  svg.donut text { font-family: 'DM Mono', monospace; }

  .tax-rows {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 14px;
  }

  .tax-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    padding: 6px 10px;
    background: rgba(255,255,255,0.02);
  }

  .tax-type { color: var(--muted); }
  .tax-rate { color: var(--text); font-weight: 500; }

  /* COMMANDMENTS */
  .cmd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.06em;
    padding: 6px 0;
    border-bottom: 1px solid rgba(201,168,76,0.06);
  }

  .cmd-check {
    color: var(--green);
    font-size: 10px;
    flex-shrink: 0;
  }

  /* FOOTER */
  .footer {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation: fadeUp 0.7s 0.4s ease both;
  }

  .footer-left {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 2;
  }

  .footer-right {
    display: flex;
    gap: 24px;
  }

  .footer-stat {
    text-align: right;
  }

  .footer-stat-label {
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .footer-stat-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    color: var(--gold-light);
    letter-spacing: 0.04em;
  }

  /* GRADE PROFILE */
  .grade-line-wrap {
    height: 80px;
    position: relative;
    margin: 12px 0;
  }

  svg.grade-line { width: 100%; height: 100%; overflow: visible; }

  .grade-labels {
    display: flex;
    justify-content: space-between;
    font-size: 8px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  /* ANIMATIONS */
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes growUp {
    from { transform: scaleY(0); transform-origin: bottom; }
    to   { transform: scaleY(1); transform-origin: bottom; }
  }

  @keyframes growRight {
    from { transform: scaleX(0); transform-origin: left; }
    to   { transform: scaleX(1); transform-origin: left; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
<script defer src="/~flock.js" data-proxy-url="/~api/analytics"></script><script defer src="/__l5e/events.js" data-artifact-kind="preview_commit_sha" data-artifact-id="552d0fa2854906776492ce237c0e44ca53bb685c" data-commit-sha="552d0fa2854906776492ce237c0e44ca53bb685c" data-context-token="v1.eyJwcm9qZWN0X2lkIjoiOTgwODRkNDktN2ZlNC00ZWYxLTg3NmUtYjNjYWEwZjJiN2Y5IiwiYXJ0aWZhY3Rfa2luZCI6InByZXZpZXdfY29tbWl0X3NoYSIsImFydGlmYWN0X2lkIjoiNTUyZDBmYTI4NTQ5MDY3NzY0OTJjZTIzN2MwZTQ0Y2E1M2JiNjg1YyIsImNvbW1pdF9zaGEiOiI1NTJkMGZhMjg1NDkwNjc3NjQ5MmNlMjM3YzBlNDRjYTUzYmI2ODVjIiwiZXhwIjoxNzgwNTYwMzQwfQ.xDExZHXBqZocOo_XjIEYuEiKt112L7l277l7Nkd5Sog"></script><meta property="og:image" content="https://pub-bb2e103a32db4e198524a2e9ed8f35b4.r2.dev/e645040f-c8c4-4398-a906-2a779addff23/id-preview-519a4c8a--98084d49-7fe4-4ef1-876e-b3caa0f2b7f9.lovable.app-1771717640596.png"><meta name="twitter:image" content="https://pub-bb2e103a32db4e198524a2e9ed8f35b4.r2.dev/e645040f-c8c4-4398-a906-2a779addff23/id-preview-519a4c8a--98084d49-7fe4-4ef1-876e-b3caa0f2b7f9.lovable.app-1771717640596.png"></head>
<body>
<div class="page">

  <!-- HEADER -->
  <div class="header">
    <div class="header-left">
      <div class="eyebrow">AI-Powered NI 43-101 Extraction · Eskay Creek Technical Report 2023</div>
      <div class="title">ESKAY <span>CREEK</span></div>
      <div class="subtitle">Life of Mine Analysis — Automated Extraction & Validation Output</div>
    </div>
    <div class="header-right">
      <div class="status-badge">All 10 Commandments Active</div>
      <div class="meta">EXTRACTION ID: ESKAY_FULL_20260217<br>VALIDATION: ESKAY_VALIDATION_20260217_001137_EST<br>STATUS: COMPLETE — 8 STEPS EXECUTED</div>
    </div>
  </div>

  <!-- KPI STRIP -->
  <div class="kpi-strip">
    <div class="kpi">
      <div class="kpi-label">LOM Revenue</div>
      <div class="kpi-value">$4.77B</div>
      <div class="kpi-sub">Au $2.94B + Ag $1.83B</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Au Payable</div>
      <div class="kpi-value">1.68M</div>
      <div class="kpi-sub">oz · @$1,750/oz</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Ag Payable</div>
      <div class="kpi-value">83.3M</div>
      <div class="kpi-sub">oz · @$22.00/oz</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">M+I Resources</div>
      <div class="kpi-value">10.3Mt</div>
      <div class="kpi-sub">6.6 g/t Au · 318 g/t Ag</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Initial CapEx</div>
      <div class="kpi-value">$852M</div>
      <div class="kpi-sub">+$161M sustaining</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Mine Life</div>
      <div class="kpi-value">10 Yr</div>
      <div class="kpi-sub">9,600 kt LOM ore</div>
    </div>
  </div>

  <!-- MAIN GRID -->
  <div class="main-grid">

    <!-- PRODUCTION SCHEDULE CHART -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Annual Production Schedule</div>
        <div class="panel-tag">TABLE 21-1 · SEC. 21.2</div>
      </div>

      <div class="chart-area">
        <div class="chart-bars">
          <!-- Year data: Au (scaled to 205k max), Ag scaled -->
          <!-- Heights: Au oz / 2050, Ag in millions / 102 -->
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:69%;animation-delay:0.05s" title="142k Au oz"></div>
              <div class="bar bar-ag" style="height:68%;animation-delay:0.05s" title="6.95M Ag oz"></div>
            </div>
            <div class="bar-label">Y1</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:87%;animation-delay:0.1s"></div>
              <div class="bar bar-ag" style="height:87%;animation-delay:0.1s"></div>
            </div>
            <div class="bar-label">Y2</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:91%;animation-delay:0.15s"></div>
              <div class="bar bar-ag" style="height:92%;animation-delay:0.15s"></div>
            </div>
            <div class="bar-label">Y3</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:96%;animation-delay:0.2s"></div>
              <div class="bar bar-ag" style="height:96%;animation-delay:0.2s"></div>
            </div>
            <div class="bar-label">Y4</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:100%;animation-delay:0.25s"></div>
              <div class="bar bar-ag" style="height:100%;animation-delay:0.25s"></div>
            </div>
            <div class="bar-label">Y5</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:97%;animation-delay:0.3s"></div>
              <div class="bar bar-ag" style="height:98%;animation-delay:0.3s"></div>
            </div>
            <div class="bar-label">Y6</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:90%;animation-delay:0.35s"></div>
              <div class="bar bar-ag" style="height:90%;animation-delay:0.35s"></div>
            </div>
            <div class="bar-label">Y7</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:83%;animation-delay:0.4s"></div>
              <div class="bar bar-ag" style="height:83%;animation-delay:0.4s"></div>
            </div>
            <div class="bar-label">Y8</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:72%;animation-delay:0.45s"></div>
              <div class="bar bar-ag" style="height:72%;animation-delay:0.45s"></div>
            </div>
            <div class="bar-label">Y9</div>
          </div>
          <div class="bar-group">
            <div class="bar-wrap">
              <div class="bar bar-au" style="height:55%;animation-delay:0.5s"></div>
              <div class="bar bar-ag" style="height:55%;animation-delay:0.5s"></div>
            </div>
            <div class="bar-label">Y10</div>
          </div>
        </div>
      </div>

      <!-- Au grade profile -->
      <div style="margin-bottom:8px;">
        <div style="font-size:9px;color:var(--muted);letter-spacing:0.1em;margin-bottom:6px;">AU GRADE PROFILE (g/t)</div>
        <div class="grade-line-wrap">
          <svg class="grade-line" viewBox="0 0 300 60">
            <defs>
              <linearGradient id="gradeGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#C9A84C" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#C9A84C" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- Grade values: 5.8, 6.2, 6.5, 6.8, 7.1, 6.9, 6.4, 5.9, 5.4, 4.9 (range 4.9-7.1 → 2.2 spread) -->
            <!-- Map: x = 15+i*30, y = 55 - (grade-4.9)/2.2 * 50 -->
